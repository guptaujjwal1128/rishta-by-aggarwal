# Copy this file to deploy/.env and fill values locally.
# Do not commit deploy/.env.

PROJECT_ID=rishta-by-aggarwal
REGION=asia-south1
ARTIFACT_REPOSITORY=rishta

BACKEND_SERVICE=rishta-api
FRONTEND_SERVICE=rishta-web

BACKEND_IMAGE=asia-south1-docker.pkg.dev/rishta-by-aggarwal/rishta/rishta-api
FRONTEND_IMAGE=asia-south1-docker.pkg.dev/rishta-by-aggarwal/rishta/rishta-web
IMAGE_TAG=latest

# Backend runtime env
NODE_ENV=production
GOOGLE_CLIENT_ID=1084232234514-mr554jri3hodjdme4ihlbadipqt73or5.apps.googleusercontent.com
GEMINI_MODEL=gemini-2.5-flash-lite
GCS_UPLOAD_BUCKET=
ADMIN_EMAIL=admin@ayrishtabyaggarwal.in
ADMIN_PASSWORD=replace-with-strong-admin-password
ADMIN_NAME="Rishta Admin"

# Secret names already created in Secret Manager.
DATABASE_URL_SECRET=rishta-database-url
JWT_SECRET_SECRET=rishta-jwt-secret
GEMINI_API_KEY_SECRET=rishta-gemini-api-key

# Optional: if set, deploy scripts use this secret instead of ADMIN_PASSWORD.
ADMIN_PASSWORD_SECRET=

# Cloud SQL connection name. Leave empty if not using Cloud SQL connector.
CLOUD_SQL_INSTANCE=rishta-by-aggarwal:asia-south1:rishta-by-aggarwal-db

# Frontend runtime env
VITE_API_URL=https://YOUR_BACKEND_URL/api
VITE_GOOGLE_CLIENT_ID=1084232234514-mr554jri3hodjdme4ihlbadipqt73or5.apps.googleusercontent.com
