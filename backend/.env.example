PORT=4000
JWT_SECRET=replace-with-a-long-random-secret
DATABASE_URL=postgres://rishta:rishta@127.0.0.1:5433/rishta_dev

# Gemini extraction. Store this in GCP Secret Manager for deployed environments.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# Google Cloud OAuth 2.0 Web Client ID for Google SSO token verification.
GOOGLE_CLIENT_ID=

# Auto-created admin login. Set these before first backend start.
ADMIN_EMAIL=admin@rishta.local
ADMIN_PASSWORD=change-this-admin-password
ADMIN_NAME=Rishta Admin
ADMIN_PHONE=

# Optional GCP deployment metadata.
GCP_PROJECT_ID=
